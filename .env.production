# =====================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =====================================
# Configuración para entornos de producción con Docker

# =====================================
# API BACKEND
# =====================================
# Origen único (RN-DEPLOY-001): el navegador habla SIEMPRE con /api del mismo
# origen; nginx hace de proxy inverso hacia el backend (template
# nginx/templates/default.conf.template en laptop, nginx/tls.conf en server).
# El backend nunca ve el prefijo /api (proxy_pass con URI final lo elimina).
# Reactivo en F2 del plan PLAN_DEPLOY_ESCALADO_ONPREMISE junto a nginx/ en el
# mismo diff (regla F7.7 de AGENTS.md).
VITE_API_URL=/api

# Timeout más largo para producción (30 segundos)
VITE_API_TIMEOUT=30000

# =====================================
# AUTENTICACIÓN
# =====================================
# IMPORTANTE: Deshabilitar auto-login en producción
VITE_AUTO_LOGIN=false

# =====================================
# ENTORNO
# =====================================
VITE_ENV=production
VITE_MODE=production
VITE_DEBUG=false

# =====================================
# FEATURE FLAGS
# =====================================
VITE_FEATURE_PRODUCTS_METRICS=true
VITE_FEATURE_INLINE_EDIT=true

# =====================================
# TELEMETRÍA Y OBSERVABILIDAD
# =====================================
VITE_TELEMETRY_ENABLED=true

# =====================================
# NOTAS DE PRODUCCIÓN
# =====================================
# - Esta configuración asume el proxy /api de nginx (mismo origen, sin CORS)
# - El backend debe estar accesible desde la red Docker como `backend:8080`
# - Ver nginx/ (template + snippet + tls.conf) para la configuración del proxy
# - Ver docs/development/FRONTEND_DEPLOY_GUIDE.md para instrucciones completas

