# =====================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =====================================
# Configuración para entornos de producción con Docker

# =====================================
# API BACKEND
# =====================================
# URL directa al backend (F7.7: sin proxy rewrite en Nginx, el browser pega directo).
# En despliegue real, sobrescribir con la URL pública del backend (Docker env / CDN).
VITE_API_URL=http://localhost:5050

# Timeout más largo para producción (30 segundos)
VITE_API_TIMEOUT=30000

# =====================================
# AUTENTICACIÓN
# =====================================
# IMPORTANTE: Deshabilitar auto-login en producción
VITE_AUTO_LOGIN=false

# =====================================
# ENTORNO
# =====================================
VITE_ENV=production
VITE_MODE=production
VITE_DEBUG=false

# =====================================
# FEATURE FLAGS
# =====================================
VITE_FEATURE_PRODUCTS_METRICS=true
VITE_FEATURE_INLINE_EDIT=true

# =====================================
# TELEMETRÍA Y OBSERVABILIDAD
# =====================================
VITE_TELEMETRY_ENABLED=true

# =====================================
# NOTAS DE PRODUCCIÓN
# =====================================
# - Esta configuración asume que Nginx está configurado como proxy
# - El backend debe estar accesible en la red Docker
# - Ver nginx.conf para configuración del proxy /api
# - Ver docs/development/FRONTEND_DEPLOY_GUIDE.md para instrucciones completas

